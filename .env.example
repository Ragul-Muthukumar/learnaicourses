# Learn AI Courses — example environment configuration
# Copy to .env and fill in secrets. Do not commit .env.

DB_NAME=learnaicourses
DB_USER=learnaicourses
DB_PASSWORD=learnaicourses_pass
DB_HOST=127.0.0.1:13306
DB_PREFIX=lac_

WP_HOME=http://127.0.0.1:8088
WP_SITEURL=http://127.0.0.1:8088

WP_DEBUG=true
WP_DEBUG_LOG=true
WP_DEBUG_DISPLAY=false

# PayPal REST API — use mock for local Buy now without credentials
# https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_MODE=mock
PAYPAL_CURRENCY=USD


# Bingeme / BG Checkout — used by wp-content/plugins/bgcheckout
# Leave empty locally until Bingeme credentials are available.
BG_API_URL=
BG_API_KEY=
BG_ENV=local
BG_COOKIE=
BG_USER_PASSWORD=ChangeMeBgUser

# Production (Hostinger): add these as PHP defines in wp-config.php instead of .env:
# define('PAYPAL_CLIENT_ID', '...');
# define('PAYPAL_CLIENT_SECRET', '...');
# define('PAYPAL_MODE', 'sandbox'); // or 'live'
# define('PAYPAL_CURRENCY', 'USD');
# Never set PAYPAL_MODE=mock on production — that enrolls without payment.


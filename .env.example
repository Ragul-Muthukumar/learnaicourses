# Learn AI Courses — example environment configuration
# Copy to .env and fill in secrets. Do not commit .env.

DB_NAME=learnaicourses
DB_USER=learnaicourses
DB_PASSWORD=learnaicourses_pass
DB_HOST=127.0.0.1:13306
DB_PREFIX=lac_

WP_HOME=http://127.0.0.1:8088
WP_SITEURL=http://127.0.0.1:8088

WP_DEBUG=true
WP_DEBUG_LOG=true
WP_DEBUG_DISPLAY=false

# PayPal REST API — use mock for local Buy now without credentials
# https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_MODE=mock
PAYPAL_CURRENCY=USD

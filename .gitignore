# Ignore local secrets and runtime noise for Learn AI Courses
.env
wp-config.php
wp-cli.phar
router.php
wp-content/debug.log
wp-content/cache/
wp-content/upgrade/
wp-content/backup-db/
*.log
.DS_Store
*.swp
*.swo

# Keep media uploads tracked so hero/course images load on other devices.
# Large future uploads can be moved to Git LFS if needed.
!wp-content/uploads/

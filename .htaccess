# Learn AI Courses — Apache rewrite rules
# Process: send pretty permalinks to index.php while allowing real files.

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /learnaicourses/
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /learnaicourses/index.php [L]
</IfModule>
